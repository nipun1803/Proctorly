{
  "name": "proctorly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app/app.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "vite:build": "vite build",
    "build": "npm run vite:build && electron-builder"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "app.proctorly",
    "productName": "Proctorly",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "app/**/*",
      "backend/**/*",
      "!backend/data/sessions/**/*"
    ],
    "asarUnpack": [
      "backend/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  }
}
